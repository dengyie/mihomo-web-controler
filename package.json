{
  "name": "mihomo-web-controler",
  "version": "1.0.0",
  "description": "Mihomo (Clash Meta) Web 控制面板与自定义规则管理网关套件",
  "author": "dengyie",
  "license": "MIT",
  "homepage": "https://github.com/dengyie/mihomo-web-controler",
  "repository": {
    "type": "git",
    "url": "https://github.com/dengyie/mihomo-web-controler.git"
  },
  "scripts": {
    "test": "npm run check:ui && node tests/test_ui_bundle.mjs && pytest",
    "start": "python3 zashboard/gateway.py",
    "reconcile": "python3 clash/rules-reconciler.py --reconcile",
    "dry-run": "python3 clash/rules-reconciler.py --dry-run",
    "build:ui": "node scripts/build-ui.mjs",
    "check:ui": "node --check zashboard/src/user-rules-ui.js && node --check zashboard/dist/assets/user-rules-ui.js",
    "check:api": "python3 -m unittest discover -s tests",
    "check:configs": "bash scripts/check-configs.sh"
  },
  "keywords": [
    "mihomo",
    "clash",
    "clash-meta",
    "dashboard",
    "rules-controller",
    "web-gateway"
  ]
}
